# Copy this file to .env and fill in real values. .env is gitignored — secrets never live in config.yaml or code.

# Alpaca paper-trading keys (free): https://app.alpaca.markets/ -> Paper account -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Anthropic API key (unused until Phase 4, declared now so the env contract is stable)
ANTHROPIC_API_KEY=

# Phase 7 notifications: fill in the one notify.channel in config.yaml names.
# imessage: the phone number (+15555550123) or Apple ID email Messages on the mini texts.
IMESSAGE_TO=
# slack: an incoming webhook URL (https://hooks.slack.com/services/...). It is a credential.
SLACK_WEBHOOK_URL=
# ntfy: the full topic URL, e.g. https://ntfy.sh/aegis-<long random string>.
# Anyone who knows the topic can read it, so treat it like a password. Subscribe to it in the ntfy phone app.
NTFY_TOPIC_URL=
# Optional: an access token, only for an ntfy server that requires one (sent as a bearer token).
NTFY_TOKEN=

# The friends' feed (feed: in config.yaml), separate from the notify channel above.
# A Discord incoming webhook URL (https://discord.com/api/webhooks/...). Anyone who
# has it can post to that channel, so it is a credential.
DISCORD_WEBHOOK_URL=

# The phone approval page (approve_web: in config.yaml). docs/approve_web/SETUP.md.
# The page's Tailscale Serve URL, e.g. https://aegis.<your-tailnet>.ts.net (https and .ts.net only).
APPROVE_WEB_URL=
# The one Tailscale login allowed to answer (as Tailscale shows it, usually your email).
APPROVE_WEB_LOGIN=
# The PIN's scrypt hash, from `python -m aegis.cli.approve_web hash-pin`. Never the PIN itself.
APPROVE_WEB_PIN_HASH=

# Signals (config.yaml signals:) need no new key: Alpaca News uses the Alpaca keys above,
# and ApeWisdom needs none.
